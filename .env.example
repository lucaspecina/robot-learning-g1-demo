# Plantilla del .env del servidor de inteligencia.
#
# Copiar a /home/lucas/go2-lab/.env EN LA VM (no en este repo) y completar.
# Git ignora el .env real; esta plantilla no lleva ningun secreto.
#
#   cp .env.example /home/lucas/go2-lab/.env
#   chmod 600 /home/lucas/go2-lab/.env
#   bash systems/systems_up.sh      # recrea el contenedor "server" con estas variables
#
# systems/systems_up.sh lo pasa como --env-file al contenedor "server". Por eso
# vale el formato de Docker, no el de bash:
#   - sin "export";
#   - SIN COMILLAS: Docker las toma como parte del valor y la clave queda invalida;
#   - sin comentarios al final de una linea con valor;
#   - sin espacios alrededor del "=".
#
# Solo el contenedor "server" recibe estas variables. La Jetson nunca ve la clave:
# manda recortes JPEG por HTTP y recibe datos ya validados.

# Endpoint del recurso de Azure AI Foundry, en formato API v1.
# El codigo usa el cliente OpenAI estandar con base_url (no AzureOpenAI), asi que
# la URL tiene que terminar en /openai/v1/ e incluir la barra final.
# systems/server/intelligence_service.py:613
AZURE_OPENAI_BASE_URL=https://TU-RECURSO.openai.azure.com/openai/v1/

# Clave del recurso Foundry (Portal -> el recurso -> Keys and Endpoint -> KEY 1).
# Se pasa como api_key= al cliente. systems/server/intelligence_service.py:616
AZURE_INFERENCE_CREDENTIAL=PEGAR-LA-CLAVE-ACA

# Nombre del DEPLOYMENT (no del modelo) que lee el reloj con vision.
# En Foundry: Deployments -> la columna "Name". El proyecto venia usando gpt-4.1-mini.
# systems/server/intelligence_service.py:606
AZURE_VISION_DEPLOYMENT=gpt-4.1-mini

# Deployment del planificador de misiones. Puede ser el mismo que el de vision;
# si se omite, el codigo cae automaticamente a AZURE_VISION_DEPLOYMENT.
# Conviene declararlo igual para poder cambiar uno sin tocar el otro.
# systems/server/intelligence_service.py:717
AZURE_PLANNER_DEPLOYMENT=gpt-4.1-mini

# --- Opcionales -------------------------------------------------------------
# Grounding DINO corre local en el contenedor "server" y ya viene horneado en la
# imagen con su revision pineada (systems/server/Dockerfile:13-21). Solo
# descomentar para sobreescribir el default.
# OPEN_VOCAB_CONFIDENCE=0.35
# OPEN_VOCAB_TEXT_CONFIDENCE=0.25
# OPEN_VOCAB_CPU_THREADS=2
